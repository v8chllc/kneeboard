# Local database URLs. The application does not connect until persistence is wired.
# These credentials are confined to the loopback-only development container.
DATABASE_URL=postgresql://kneeboard:local_only_kneeboard@127.0.0.1:54329/kneeboard_dev
TEST_DATABASE_URL=postgresql://kneeboard:local_only_kneeboard@127.0.0.1:54329/kneeboard_test

# Generate a unique secret with `openssl rand -base64 32` before signing in.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-random-32-character-secret
AUTH_EMAIL_ALLOWLIST=example@email.local
MAIL_FROM_EMAIL=login@kneeboard.local
MAIL_DELIVERY=mailpit
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025

# Explicit loopback stub origin for local OFP loads. Production must use exactly
# https://www.simbrief.com; never use the live origin in local tests or journeys.
SIMBRIEF_BASE_URL=http://127.0.0.1:8765
